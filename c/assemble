#include <stdio.h>
#include <stdlib.h>
#include <ctype.h>
#include <string.h>

#include "datestamp.h"
#include "error.h"
#include "mem.h"
#include "options.h"
#include "system.h"
#include "apcscli.h"

#ifndef GCC_BIN_DIR
#define GCC_BIN_DIR ""
#endif

static char buf[2048];

void AssembleFile(void) {

  int rc;

  if (opt.ofile) {
    int throwback;
#ifdef __riscos
    throwback = opt.throwback;
#else
    throwback = 0;
#endif

    switch (CODE64 ? tc_gcc : opt.toolchain)
    {
      case tc_norcroft:
        {
          unsigned long flags = opt.apcs;
          char *bufend;
          bufend = buf + sprintf(buf, "%s -nowarn %s %s -o %s -apcs ",
                                 NORCROFT_OBJASM,
                                 throwback ? "-throwback " : "",
                                 opt.sfile, opt.ofile);
          bufend += apcscli_buildstring(flags, ~(APCS_32BIT |
                                                 APCS_SWSTACKCHECK),
                                        1, bufend, buf+2048-bufend);
        }
        break;
      case tc_gcc:
      case tc_lcc:
        {
#ifdef GCC_AS64_PATHVAR
            char *gcc_as;
            int using_asasm_default = 0;
            gcc_as = getenv(CODE64 ? GCC_AS64_PATHVAR : GCC_AS32_PATHVAR);
            if (!gcc_as && CODE64)
                gcc_as = "riscos64-as";
            if (!gcc_as && CODE32)
            {
                /* The veneer we generate is genuine ObjAsm syntax (AREA/
                 * GBLL/MACRO/|bar-quoted| symbols, etc), which GNU as
                 * (what "gcc -xassembler" below would invoke) cannot parse
                 * at all - confirmed empirically, not a flag/spelling
                 * issue like the -apcs32/-apcsfpv3 one above. GCCSDK's own
                 * bundled asasm (part of the GCCSDK sources - not written
                 * by anyone on this team) understands this syntax and is
                 * the correct default here - it takes "-o <out> <in>"
                 * rather than the "-c <in> -o <out>" shape below. */
                gcc_as = "asasm";
                using_asasm_default = 1;
            }
            if (gcc_as && using_asasm_default)
            {
                /* asasm silently produces no output at all for a relative
                 * -o path with a subdirectory component that doesn't
                 * already start with "./" (eg "o/testmod") - confirmed
                 * empirically: "-o o/testmod" exits 0 with no file
                 * written, "-o ./o/testmod" works. Whether opt.ofile
                 * already has a leading "./" or "/" isn't guaranteed by
                 * anything upstream, so add one whenever it's a relative
                 * path without one, rather than relying on callers to
                 * happen to pass paths in the one shape asasm accepts. */
                sprintf(buf, "%s -o %s%s %s",
                             gcc_as,
                             (opt.ofile[0] == '/' || (opt.ofile[0] == '.' && opt.ofile[1] == '/')) ? "" : "./",
                             opt.ofile, opt.sfile);
            }
            else if (gcc_as)
            {
                sprintf(buf, "%s -c %s -o %s",
                             gcc_as, opt.sfile, opt.ofile);
            }
#else
            if (0)
            {
                /* Empty so we can use else */
            }
#endif
            else
            {
                /* No dedicated assembler configured - assemble via GCC
                 * itself (-xassembler). CODE32's -mabi=apcs-32/-mfpe=2/
                 * -mno-apcs-stack-check replace this file's previous
                 * -apcs32/-apcsfpv3, which were never valid GCC options on
                 * any GCCSDK build we could find and test against (that
                 * spelling doesn't match GCC's -m<name> convention at
                 * all) - -mabi=apcs-32 is the real APCS-32 ABI selector,
                 * -mfpe=2 matches this tool's own advertised default FPE
                 * variant (see the -apcs help text), and
                 * -mno-apcs-stack-check avoids every compiled module
                 * needing a __rt_stkovf_split_small/_big runtime symbol
                 * neither our own C library nor GCCSDK's default
                 * environment currently provides. */
                char *riscos_gcc = getenv(RISCOS_GCC_PATHVAR);
                if (!riscos_gcc)
                    riscos_gcc = RISCOS_GCC_DEFAULT;
                sprintf(buf, GCC_BIN_DIR "%s -xassembler -mmodule %s %s -c %s -o %s",
                             riscos_gcc,
                             (CODE32) ? "-mabi=apcs-32 -mfpe=2 -mno-apcs-stack-check" : "",
                             throwback ? "-mthrowback" : "",
                             opt.sfile, opt.ofile);
            }
        }
        break;
    }

    /* printf("Command: %s\n",buf); */

    rc = our_system(buf);
    switch (rc) {
      case EXIT_SUCCESS:
        /* Yo, success! print a message ? Nah, just return */
        return;

      case -2:
        /* Erm... not enough memory... or not there... or something... */
        ErrorFatal("Unable to spawn assembler");
        break;

      default:
        /* They returned something icky. Obviously that's a fault; they
           should have already displayed an error as to the fault though.
         */
        fprintf(stderr,"Assembling: %s\n",buf);
        fprintf(stderr,"Assembler returned %i unexpectedly; aborting\n",rc);
        exit(rc);
    }
  }
}
